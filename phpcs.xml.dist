<?xml version="1.0"?>
<ruleset name="GrowthLab Bundle Builder for WooCommerce">
	<description>WordPress Coding Standards ruleset for GrowthLab Bundle Builder for WooCommerce.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="growthlab-bundle-builder-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- manage_woocommerce is a real WooCommerce capability; WPCS only knows core WP capabilities. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- The WP template hierarchy resolves this file by matching the `glbbwc_bundle` post
	     type slug exactly, underscore included, so the filename cannot be hyphenated. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/templates/single-glbbwc_bundle.php</exclude-pattern>
	</rule>
</ruleset>
